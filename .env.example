# Smartlearn environment template
# Copy to .env.local for local development. Never commit real secrets.

# Core Supabase authentication and data access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI powers chat, generation, vision, audio transcription, and embeddings.
OPENAI_API_KEY=your-openai-api-key
# Optional organization Admin API key for exact owner-dashboard usage and costs.
# This is server-only and is not the same as OPENAI_API_KEY.
OPENAI_ADMIN_KEY=

# Server-only owner dashboard allowlist. Configure at least one value; comma-separated.
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Public application origin (no trailing slash; HTTPS in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional Supabase sign-in buttons: google,github,azure
NEXT_PUBLIC_OAUTH_PROVIDERS=google,azure

# Cloudflare Turnstile site key. Configure its secret in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Classroom and Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional for public Drive metadata; authenticated Drive reads use OAuth.
GOOGLE_DRIVE_API_KEY=

# Canvas LMS
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Optional separate HMAC secret; CANVAS_CLIENT_SECRET is the fallback.
CANVAS_OAUTH_STATE_SECRET=
# Comma-separated custom Canvas OAuth domains. *.instructure.com is allowed by default.
CANVAS_ALLOWED_DOMAINS=

# Microsoft Teams Education
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Infinite Campus OAuth (token-based connection can work without these)
INFINITE_CAMPUS_CLIENT_ID=
INFINITE_CAMPUS_CLIENT_SECRET=
INFINITE_CAMPUS_OAUTH_STATE_SECRET=
INFINITE_CAMPUS_ALLOWED_DOMAINS=

# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-value

# Stripe subscriptions (all three values must come from the same test/live mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PLUS_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_MAX_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional when using an API-created, non-default customer portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=

# Transactional billing email (verify the sender domain in Resend first)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Smartlearn <billing@updates.your-domain.com>
# Optional inbox that should receive replies to billing emails.
RESEND_REPLY_TO=

# Local-only test optimization; never enable in production.
LOW_TOKEN_TEST_MODE=false
